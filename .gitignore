# This repo's root is a shared parent folder. ALLOWLIST: ignore everything at the root,
# then re-include only the SAT Sprint files. Sibling projects here are never part of this repo.
/*
!/.gitignore
!/LICENSE
!/README.md
!/index.html
!/package.json
!/package-lock.json
!/postcss.config.js
!/tailwind.config.js
!/tsconfig.json
!/vite.config.ts
!/docs/
!/public/
!/scripts/
!/src/

# build/tooling artifacts (also inside the allowed dirs)
node_modules
dist
dist-ssr
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json
.gstack/
